rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      function isPostOwner() {
        return request.auth != null
               && resource.data.authorId == request.auth.uid;
      }

      function updatesOnlyEditablePostFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'schoolDivision',
          'title',
          'purpose',
          'howToUse',
          'reflection',
          'resourceUrl',
          'aiTags',
          'updatedAt'
        ]);
      }

      function addsInitialAttachments() {
        return !resource.data.keys().hasAll(['attachments'])
               && request.resource.data.keys().hasAll(['attachments'])
               && hasValidAttachments()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'attachments',
                 'updatedAt'
               ]);
      }

      function isValidAttachment(attachment) {
        return attachment is map
               && attachment.keys().hasAll([
                 'id',
                 'name',
                 'storagePath',
                 'downloadUrl',
                 'contentType',
                 'size',
                 'category'
               ])
               && attachment.id is string
               && attachment.name is string
               && attachment.storagePath is string
               && attachment.downloadUrl is string
               && attachment.contentType is string
               && attachment.size is int
               && attachment.category is string
               && attachment.storagePath.matches(
                 '^posts/' + postId + '/' + request.auth.uid + '/[^/]+$'
               );
      }

      function hasValidAttachments() {
        return request.resource.data.attachments is list
               && request.resource.data.attachments.size() <= 3
               && (request.resource.data.attachments.size() < 1
                   || isValidAttachment(request.resource.data.attachments[0]))
               && (request.resource.data.attachments.size() < 2
                   || isValidAttachment(request.resource.data.attachments[1]))
               && (request.resource.data.attachments.size() < 3
                   || isValidAttachment(request.resource.data.attachments[2]));
      }

      function updatesEditableFieldsAndRemovesAttachments() {
        return resource.data.keys().hasAll(['attachments'])
               && request.resource.data.keys().hasAll(['attachments'])
               && resource.data.attachments is list
               && request.resource.data.attachments is list
               && resource.data.attachments.hasAll(request.resource.data.attachments)
               && request.resource.data.attachments.size() <= resource.data.attachments.size()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'schoolDivision',
                 'title',
                 'purpose',
                 'howToUse',
                 'reflection',
                 'resourceUrl',
                 'aiTags',
                 'attachments',
                 'updatedAt'
               ]);
      }

      function updatesEditableFieldsAndAttachments() {
        return request.resource.data.keys().hasAll(['attachments'])
               && hasValidAttachments()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'schoolDivision',
                 'title',
                 'purpose',
                 'howToUse',
                 'reflection',
                 'resourceUrl',
                 'aiTags',
                 'attachments',
                 'updatedAt'
               ]);
      }

      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;

      allow update: if isPostOwner()
                    && request.resource.data.authorId == resource.data.authorId
                    && (updatesOnlyEditablePostFields()
                        || updatesEditableFieldsAndRemovesAttachments()
                        || updatesEditableFieldsAndAttachments()
                        || addsInitialAttachments());

      allow delete: if isPostOwner();
    }
  }
}
